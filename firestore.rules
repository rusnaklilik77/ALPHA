rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Вход в режим администратора проверяется на клиенте (логин/пароль в
    // src/lib/data.js), а не отдельной ролью на сервере — поэтому здесь
    // «админом» считается просто любой, кто вошёл в приложение под своим
    // обычным аккаунтом. Это значит, что чужие данные технически может
    // прочитать любой авторизованный сотрудник напрямую через Firestore,
    // в обход окна с паролем — реальная защита от этого только в UI.
    // Если это важно, замени эту функцию на проверку email из
    // ADMIN_EMAILS, как было раньше, и заведи отдельный
    // Firebase-аккаунт(-ы) администратора.
    function isAdmin() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Читать документ можно себе — всегда, а администратору — любой
      // (это же правило действует и на запрос списка всех сотрудников).
      // Дополнительно: документ с уже включённым сканером (в нём есть
      // поле scanToken) можно прочитать и без входа в систему — это
      // нужно странице-компаньону сканера (ScanPage), которая открывается
      // по QR-коду на отдельном устройстве без email/пароля. Настоящий
      // "замок" здесь — сам секретный scanToken: без него узнать uid
      // недостаточно, чтобы что-то изменить (см. правило записи в
      // entries ниже). Это тот же компромисс "простота вместо серверной
      // роли", что и у остального проекта (см. isAdmin() выше).
      allow read: if (request.auth != null && (request.auth.uid == userId || isAdmin()))
        || (resource.data.scanToken is string);
      // Изменять свой документ может только сам пользователь.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Доход за месяц для курьеров на шопе (вводится вручную, без ставки за
      // посылку) — читает сам сотрудник и админ, пишет только сам сотрудник.
      match /monthlyPay/{monthId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /entries/{entryId} {
        // Свои записи о доставках видит владелец, чужие — только админ
        // (для экрана статистики сотрудника).
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Редактировать/удалять записи можно у себя, либо со страницы
        // сканера — но только если в самой записи передан scanToken,
        // совпадающий с тем, что хранится в users/{userId}.scanToken.
        // get() внутри правила не требует отдельного разрешения на
        // чтение — это стандартный приём Firestore Rules.
        allow write: if (request.auth != null && request.auth.uid == userId)
          || (request.resource.data.scanToken is string
              && request.resource.data.scanToken
                == get(/databases/$(database)/documents/users/$(userId)).data.scanToken);
      }
    }
  }
}
